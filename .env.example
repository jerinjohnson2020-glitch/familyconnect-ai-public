# ==============================================================================
# FamilyConnect AI — Production & Local Environment Configuration (.env.example)
# ==============================================================================

# 1. Runtime & Security
ENVIRONMENT=production
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-strong-64-char-production-secret-key
ALLOWED_ORIGINS=https://familyconnect-ai.onrender.com,http://localhost:5173
# Public frontend URL for household invitation links and email redirects (e.g. http://192.168.1.50:5173 or https://familyconnect.yourdomain.com)
FRONTEND_PUBLIC_URL=
FAMILYCONNECT_PUBLIC_URL=https://familyconnect-ai.onrender.com

# 2. Persistent Database Configuration
# In production (ENVIRONMENT=production), a persistent PostgreSQL database instance is strictly required.
# The application will refuse to start if DATABASE_URL is unset, empty, or configured for SQLite.
# Recommended connection format (using psycopg2 driver):
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# Note for local development only (ENVIRONMENT=development):
# If DATABASE_URL is omitted in development mode, the backend defaults to local SQLite.
# FAMILYCONNECT_DB_PATH=familyconnect.db

# 3. AI Triage Model Version ('v2' default with NLP context extraction, or 'v1' rollback)
TRIAGE_MODEL_VERSION=v2

# 4. Trusted-Contact Notification Providers (Phase 5B)
# Configure at least one Email (SMTP or Resend) or SMS (Twilio) provider for live delivery.
# When unconfigured, alerts are honestly recorded as status=FAILED (provider=unconfigured).

# Option A: SMTP Email Provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@familyconnect.local
SMTP_USE_TLS=true

# Option B: Resend HTTP Email API
RESEND_API_KEY=
# Verified email sender address registered and domain-verified in your Resend account.
# Deployers must configure a domain they own or are authorized to use and have verified in Resend.
# E.g.: RESEND_FROM_EMAIL="Family Connect AI <notifications@your-verified-domain.com>"
RESEND_FROM_EMAIL="Family Connect AI <notifications@your-verified-domain.com>"

# Option C: Twilio SMS API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Retry attempts for transient provider failures
NOTIFICATION_MAX_ATTEMPTS=2

# Mock notifications mode (set to true during development, automated testing, or hackathon demos
# to safely record SIMULATED delivery without dispatching real SMS or emails)
MOCK_NOTIFICATIONS=true

# 5. First-Aid Assistant & Optional Local LLM (Stage 3 Integration)
# Bounded reading comprehension over retrieved protocols via local Ollama daemon.
# Zero external network calls. Defaults to disabled; verified protocol steps display cleanly if disabled.
ENABLE_LOCAL_LLM=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=15.0
